  workspaceId String             @db.Uuid
  type        KnowledgeSpaceType
  teamId      String?            @db.Uuid
  projectId   String?            @db.Uuid
  key         String
  name        String
  description String?
  icon        String?
  createdById String?            @db.Uuid
  updatedById String?            @db.Uuid
  createdAt   DateTime           @default(now())
