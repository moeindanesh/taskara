generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
  AGENT
}

/// Selects one coherent product/domain profile for a Workspace. Existing workspaces are TEAM;
/// SUPPORT workspaces use Cases and Departments instead of Tasks and Teams for daily operations.
enum WorkspaceMode {
  TEAM
  SUPPORT
}

enum DepartmentMemberRole {
  MEMBER
  MANAGER
}

/// Routing eligibility is opt-in. Existing Department members remain unavailable until a manager
/// explicitly gives them capacity, so enabling a policy cannot silently expose peer workloads.
enum SupportRoutingAvailability {
  UNAVAILABLE
  AVAILABLE
}

enum SupportRoutingAssignmentMode {
  DEPARTMENT_INBOX
  CAPACITY_AWARE
}

/// PRIVATE is visible only to its owner. DEPARTMENT is shared only among current managers of the
/// referenced Department (plus Support-wide readers); WORKSPACE is limited to Support-wide readers.
enum SupportSavedViewVisibility {
  PRIVATE
  DEPARTMENT
  WORKSPACE
}

enum SupportAssistanceKind {
  TYPE
  PRIORITY
  DEPARTMENT
  DUPLICATE
  SUMMARY
  REPLY
  KNOWLEDGE
}

enum SupportAssistanceDecision {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SupportEnablementKind {
  MACRO
  TEMPLATE
  AUTOMATION
}

enum SupportEnablementStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum SupportProblemClusterStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

enum SupportKnowledgeUsefulness {
  HELPFUL
  PARTIAL
  NOT_HELPFUL
}

enum SupportKnowledgeOutcome {
  RESOLVED
  ADVANCED
  NO_EFFECT
}

enum SupportKnowledgeGapKind {
  MISSING
  WRONG
}

enum SupportKnowledgeGapStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum SupportPermissionRole {
  TRIAGER
  SUPERVISOR
}

/// Agent credentials do not inherit their holder's human Support permissions. Each capability is
/// granted explicitly and evaluated before WorkspaceRole implications.
enum SupportCredentialScope {
  CASE_READ
  CASE_WRITE
  TRIAGE
  CONFIGURE
  INTAKE
}

enum SupportCaseSourceChannel {
  API
  CALL
  MANUAL
  EMAIL
  MESSAGING
}

enum SupportCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportCaseImpact {
  LOW
  MEDIUM
  HIGH
}

enum SupportCaseUrgency {
  LOW
  MEDIUM
  HIGH
}

enum SupportCaseStatus {
  NEW
  OPEN
  WAITING_ON_CUSTOMER
  WAITING_ON_INTERNAL
  RESOLVED
  CLOSED
}

enum SupportCaseResolutionCode {
  FIXED
  ANSWERED
  WORKAROUND
  DUPLICATE
  NO_RESPONSE
  NOT_REPRODUCIBLE
  REJECTED
  WITHDRAWN
  SPAM
}

enum SupportInteractionKind {
  MESSAGE
  CALL
  NOTE
}

enum SupportInteractionVisibility {
  PUBLIC
  INTERNAL
}

enum SupportInteractionDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum SupportCallDisposition {
  ANSWERED
  MISSED
  ABANDONED
  VOICEMAIL
}

enum SupportRecordingConsent {
  UNKNOWN
  GIVEN
  DENIED
  NOT_REQUIRED
}

enum SupportCaseEventSource {
  WEB
  API
  CONNECTOR
  CALL_CENTER
  SYSTEM
}

enum SupportConnectorSignatureScheme {
  HMAC_SHA256
  ED25519
}

enum SupportConnectorStatus {
  ACTIVE
  REVOKED
}

enum SupportIntakeReceiptStatus {
  RECEIVED
  PROCESSING
  RETRY_PENDING
  PROCESSED
  REJECTED
  DEAD_LETTER
}

enum SupportOutboxStatus {
  PENDING
  PROCESSING
  RETRY_PENDING
  DELIVERED
  DEAD_LETTER
}

enum SupportSlaMetric {
  TRIAGE
  FIRST_RESPONSE
  NEXT_RESPONSE
  RESOLUTION
  FOLLOW_UP
  MEMBER_ASSIGNMENT
}

enum SupportSlaClockState {
  RUNNING
  PAUSED
  MET
  BREACHED
  CANCELED
}

enum SupportJobLeaseStatus {
  PENDING
  RUNNING
  RETRY_PENDING
  COMPLETED
  DEAD_LETTER
}

enum WorkspaceConnectionStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum SupportCaseTaskLinkType {
  FIX_WORK
  INVESTIGATION
  FOLLOW_UP
  RELATED
}

/// The deliberately coarse Case state published into an approved Team workspace.
enum SupportCaseSignalStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum UserKind {
  HUMAN
  AGENT
}

enum AgentCredentialScope {
  READ_ONLY
  READ_WRITE
}

enum ProjectRole {
  LEAD
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskKind {
  WORK
  EFFORT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELED
}

enum TaskPriority {
  NO_PRIORITY
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSource {
  WEB
  API
  MATTERMOST
  CODEX
  AGENT
  SYSTEM
}

enum ActorType {
  USER
  SYSTEM
  AGENT
  MATTERMOST
  CODEX
}

/// Which agent runtime performed an action. One agent User serves all four runtimes, so the
/// identity cannot carry this — it rides per-action and is snapshotted onto the row it produced.
/// Client-asserted, unlike ActorType, which is derived from the authenticated User's kind.
enum AgentRuntime {
  CLAUDE_CODE
  CODEX
  OPENCLAW
  HERMES
}

enum IntegrationProvider {
  MATTERMOST
  CODEX
}

enum AgentRunKind {
  TRIAGE
  FOLLOW_UP
  DAILY_PLAN
  PROJECT_HEALTH
  THREAD_TO_TASKS
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum AgentActionStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  APPLIED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MeetingStatus {
  PLANNED
  HELD
  CANCELED
  ARCHIVED
}

enum MeetingParticipantRole {
  OWNER
  PARTICIPANT
}

enum MeetingActionItemStatus {
  OPEN
  DONE
  CANCELED
}

enum SmsDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

enum KnowledgeSpaceType {
  WORKSPACE
  TEAM
  PROJECT
}

enum KnowledgePageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KnowledgeReferenceType {
  PAGE
  TASK
  PROJECT
  MEETING
  ANNOUNCEMENT
  EXTERNAL_URL
}

enum AttentionItemStatus {
  OPEN
  SNOOZED
  RESOLVED
  DISMISSED
}

enum AttentionItemSeverity {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskReviewStatus {
  REQUESTED
  CHANGES_REQUESTED
  APPROVED
  CANCELED
}

enum TaskTriageStatus {
  OPEN
  WAITING_FOR_INFO
  SNOOZED
}

enum ProjectUpdateHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum MilestoneKind {
  FEATURE
  PHASE
  OTHER
}

enum MilestoneStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELED
}

enum MilestoneHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

model Workspace {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  description String?
  mode        WorkspaceMode @default(TEAM)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users                   WorkspaceMember[]
  teams                   Team[]
  projects                Project[]
  projectHealthUpdates    ProjectHealthUpdate[]
  milestones              Milestone[]
  tasks                   Task[]
  labels                  Label[]
  cycles                  Cycle[]
  views                   View[]
  announcements           Announcement[]
  announcementRecipients  AnnouncementRecipient[]
  announcementPolls       AnnouncementPoll[]
  announcementPollOptions AnnouncementPollOption[]
  announcementPollVotes   AnnouncementPollVote[]
  meetings                Meeting[]
  meetingParticipants     MeetingParticipant[]
  checkInResponses        CheckInResponse[]
  oneOnOneSeries          OneOnOneSeries[]
  oneOnOneAgendaItems     OneOnOneAgendaItem[]
  meetingActionItems      MeetingActionItem[]
  knowledgeSpaces         KnowledgeSpace[]
  knowledgePages          KnowledgePage[]
  knowledgeLabels         KnowledgeLabel[]
  knowledgeComments       KnowledgePageComment[]
  knowledgeSubscriptions  KnowledgePageSubscription[]
  knowledgeReferences     KnowledgePageReference[]
  notifications           Notification[]
  attentionItems          AttentionItem[]
  taskReviewRequests      TaskReviewRequest[]
  taskTriageStates        TaskTriageState[]
  userCapacities          UserCapacity[]
  teamWorkingAgreements   TeamWorkingAgreement[]
  taskSubscriptions       TaskSubscription[]
  taskMutes               TaskMute[]
  activityLogs            ActivityLog[]
  smsDeliveries           SmsDelivery[]
  integrations            IntegrationAccount[]
  mattermostBindings      MattermostBinding[]
  agentRuns               AgentRun[]
  invites                 WorkspaceInvite[]
  agentCredentials        AgentCredential[]
  supportState            SupportWorkspaceState?
  departments             Department[]
  supportCases            SupportCase[]
  supportContacts         SupportContact[]
  supportConnectors       SupportIntakeConnector[]
  supportCalendars        SupportBusinessCalendar[]
  supportSlaPolicies      SupportSlaPolicy[]
  supportRoutingPolicies  SupportRoutingPolicy[]
  supportSavedViews       SupportSavedView[]
  supportSuggestions      SupportAssistanceSuggestion[]
  supportCsatInvitations  SupportCsatInvitation[]
  supportQualityRubrics   SupportQualityRubric[]
  supportQualityReviews   SupportQualityReview[]
  supportEnablementDefinitions SupportEnablementDefinition[]
  supportEnablementApplications SupportEnablementApplication[]
  supportProblemClusters SupportProblemCluster[]
  supportCaseKnowledgeUses SupportCaseKnowledgeUse[]
  supportKnowledgeGaps   SupportKnowledgeGap[]
  supportJobLeases        SupportJobLease[]
  supportOutboxEvents     SupportOutboxEvent[]
  supportConnections      WorkspaceConnection[]         @relation("SupportWorkspaceConnections")
  teamConnections         WorkspaceConnection[]         @relation("TeamWorkspaceConnections")
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  name                  String
  kind                  UserKind  @default(HUMAN)
  operatorId            String?   @db.Uuid
  aiModel               String?
  phone                 String?   @unique
  passwordHash          String?
  mattermostUserId      String?   @unique
  mattermostUsername    String?   @unique
  avatarUrl             String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  operator User?  @relation("AgentOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  agents   User[] @relation("AgentOperator")

  workspaces                      WorkspaceMember[]
  authSessions                    AuthSession[]
  teamMemberships                 TeamMember[]
  projectMemberships              ProjectMember[]
  ledProjects                     Project[]                     @relation("ProjectLead")
  authoredProjectHealthUpdates    ProjectHealthUpdate[]         @relation("ProjectHealthUpdateAuthor")
  ownedMilestones                 Milestone[]                   @relation("MilestoneOwner")
  assignedTasks                   Task[]                        @relation("AssignedTasks")
  reportedTasks                   Task[]                        @relation("ReportedTasks")
  createdAnnouncements            Announcement[]                @relation("AnnouncementCreator")
  announcementRecipients          AnnouncementRecipient[]
  announcementPollVotes           AnnouncementPollVote[]
  ownedMeetings                   Meeting[]                     @relation("MeetingOwner")
  createdMeetings                 Meeting[]                     @relation("MeetingCreator")
  meetingParticipants             MeetingParticipant[]
  checkInResponses                CheckInResponse[]             @relation("CheckInUser")
  authoredCheckInResponses        CheckInResponse[]             @relation("CheckInAuthor")
  managedOneOnOnes                OneOnOneSeries[]              @relation("OneOnOneManager")
  participantOneOnOnes            OneOnOneSeries[]              @relation("OneOnOneParticipant")
  createdOneOnOneAgendaItems      OneOnOneAgendaItem[]          @relation("OneOnOneAgendaCreator")
  assignedMeetingActionItems      MeetingActionItem[]           @relation("MeetingActionAssignee")
  createdMeetingActionItems       MeetingActionItem[]           @relation("MeetingActionCreator")
  createdKnowledgeSpaces          KnowledgeSpace[]              @relation("KnowledgeSpaceCreator")
  updatedKnowledgeSpaces          KnowledgeSpace[]              @relation("KnowledgeSpaceUpdater")
  ownedKnowledgePages             KnowledgePage[]               @relation("KnowledgePageOwner")
  createdKnowledgePages           KnowledgePage[]               @relation("KnowledgePageCreator")
  updatedKnowledgePages           KnowledgePage[]               @relation("KnowledgePageUpdater")
  verifiedKnowledgePages          KnowledgePage[]               @relation("KnowledgePageVerifier")
  authoredKnowledgePageVersions   KnowledgePageVersion[]
  knowledgePageComments           KnowledgePageComment[]        @relation("KnowledgePageCommentAuthor")
  resolvedKnowledgePageComments   KnowledgePageComment[]        @relation("KnowledgePageCommentResolver")
  knowledgePageSubscriptions      KnowledgePageSubscription[]
  taskSubscriptions               TaskSubscription[]
  taskMutes                       TaskMute[]
  comments                        TaskComment[]
  notifications                   Notification[]                @relation("NotificationRecipient")
  causedNotifications             Notification[]                @relation("NotificationActor")
  assignedAttentionItems          AttentionItem[]               @relation("AttentionAssignee")
  managedAttentionItems           AttentionItem[]               @relation("AttentionManager")
  requestedTaskReviews            TaskReviewRequest[]           @relation("TaskReviewRequester")
  assignedTaskReviews             TaskReviewRequest[]           @relation("TaskReviewReviewer")
  taskTriageDecisions             TaskTriageState[]             @relation("TaskTriageDecider")
  capacities                      UserCapacity[]
  activityLogs                    ActivityLog[]
  smsDeliveries                   SmsDelivery[]                 @relation("SmsDeliveryRequester")
  createdAgentRuns                AgentRun[]
  approvedActions                 AgentAction[]
  sentInvites                     WorkspaceInvite[]             @relation("WorkspaceInviteInviter")
  acceptedInvites                 WorkspaceInvite[]             @relation("WorkspaceInviteAccepter")
  agentCredentials                AgentCredential[]             @relation("AgentCredentialAgent")
  issuedAgentCredentials          AgentCredential[]             @relation("AgentCredentialIssuer")
  revokedAgentCredentials         AgentCredential[]             @relation("AgentCredentialRevoker")
  authoredSupportInteractions     SupportInteraction[]          @relation("SupportInteractionAuthor")
  redactedSupportContent          SupportInteractionContent[]   @relation("SupportContentRedactor")
  authoredSupportCaseEvents       SupportCaseEvent[]            @relation("SupportCaseEventActor")
  revokedSupportConnectors        SupportIntakeConnector[]      @relation("SupportConnectorRevoker")
  approvedSupportConnections      WorkspaceConnection[]         @relation("SupportConnectionApprover")
  approvedTeamConnections         WorkspaceConnection[]         @relation("TeamConnectionApprover")
  revokedWorkspaceConnections     WorkspaceConnection[]         @relation("WorkspaceConnectionRevoker")
  createdDepartmentWorkTargets    DepartmentWorkTarget[]        @relation("DepartmentWorkTargetCreator")
  createdSupportCaseTaskLinks     SupportCaseTaskLink[]         @relation("SupportCaseTaskLinkCreator")
  createdSupportRoutingPolicies   SupportRoutingPolicy[]        @relation("SupportRoutingPolicyCreator")
  activatedSupportRoutingPolicies SupportRoutingPolicy[]        @relation("SupportRoutingPolicyActivator")
  createdSupportSuggestions       SupportAssistanceSuggestion[] @relation("SupportSuggestionCreator")
  decidedSupportSuggestions       SupportAssistanceSuggestion[] @relation("SupportSuggestionDecider")
  createdSupportCsatInvitations   SupportCsatInvitation[]       @relation("SupportCsatInvitationCreator")
  createdSupportQualityRubrics    SupportQualityRubric[]        @relation("SupportQualityRubricCreator")
  authoredSupportQualityReviews   SupportQualityReview[]        @relation("SupportQualityReviewReviewer")
  receivedSupportQualityReviews   SupportQualityReview[]        @relation("SupportQualityReviewAssignee")
  createdSupportEnablementDefinitions SupportEnablementDefinition[] @relation("SupportEnablementDefinitionCreator")
  approvedSupportEnablementDefinitions SupportEnablementDefinition[] @relation("SupportEnablementDefinitionApprover")
  retiredSupportEnablementDefinitions SupportEnablementDefinition[] @relation("SupportEnablementDefinitionRetirer")
  appliedSupportEnablementApplications SupportEnablementApplication[] @relation("SupportEnablementApplicationApplier")
  undoneSupportEnablementApplications SupportEnablementApplication[] @relation("SupportEnablementApplicationUndoer")
  createdSupportProblemClusters SupportProblemCluster[] @relation("SupportProblemClusterCreator")
  linkedSupportProblemClusterCases SupportProblemClusterCase[] @relation("SupportProblemClusterCaseLinker")
  createdSupportCaseKnowledgeUses SupportCaseKnowledgeUse[] @relation("SupportCaseKnowledgeUseCreator")
  createdSupportKnowledgeGaps SupportKnowledgeGap[] @relation("SupportKnowledgeGapCreator")
  reviewedSupportKnowledgeGaps SupportKnowledgeGap[] @relation("SupportKnowledgeGapReviewer")

  // Lets AgentCredential carry a composite foreign key to (id, kind), which is what makes
  // "a credential can only ever belong to an AGENT" a database fact rather than a convention.
  @@unique([id, kind])
  @@index([operatorId])
  @@index([kind])
}

model AuthSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A long-lived, non-expiring-by-default, revocable secret that lets one agent User act in exactly
/// one Workspace. Only `tokenHash` is ever stored; the plaintext is returned once, at creation.
model AgentCredential {
  id          String               @id @default(uuid()) @db.Uuid
  workspaceId String               @db.Uuid
  userId      String               @db.Uuid
  /// Pinned to AGENT by a CHECK constraint and carried into the composite FK on (userId, userKind).
  userKind    UserKind             @default(AGENT)
  name        String
  /// The public half of the token. Safe to display and to log; it identifies the row so the secret
  /// half can be compared in constant time instead of being looked up by its own hash.
  lookupId    String               @unique
  tokenHash   String
  scope       AgentCredentialScope @default(READ_WRITE)
  createdById String?              @db.Uuid
  revokedById String?              @db.Uuid
  lastUsedAt  DateTime?
  rotatedAt   DateTime?
  /// Null means never expires. That is the point of the primitive: a headless agent on a bearer
  /// session silently 401s once TASKARA_SESSION_TTL_DAYS elapses.
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent         User                     @relation("AgentCredentialAgent", fields: [userId, userKind], references: [id, kind], onDelete: Cascade)
  createdBy     User?                    @relation("AgentCredentialIssuer", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy     User?                    @relation("AgentCredentialRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  supportGrants SupportCredentialGrant[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvite {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @db.Uuid
  email        String
  name         String?
  role         WorkspaceRole @default(MEMBER)
  token        String?       @unique
  tokenHash    String        @unique
  invitedById  String?       @db.Uuid
  acceptedById String?       @db.Uuid
  acceptedAt   DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime      @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User?     @relation("WorkspaceInviteInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?     @relation("WorkspaceInviteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([expiresAt])
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentMemberships   DepartmentMember[]
  supportSavedViews       SupportSavedView[]
  supportPermissionGrants SupportPermissionGrant[]
  supportAccessEpoch      SupportAccessEpoch?
  supportCallCallbacks    SupportCallDetail[]

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members           TeamMember[]
  projects          Project[]
  meetings          Meeting[]
  knowledgeSpaces   KnowledgeSpace[]
  workingAgreements TeamWorkingAgreement[]

  @@unique([workspaceId, slug])
}

model TeamMember {
  id        String        @id @default(uuid()) @db.Uuid
  teamId    String        @db.Uuid
  userId    String        @db.Uuid
  role      WorkspaceRole @default(MEMBER)
  createdAt DateTime      @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @db.Uuid
  teamId         String?       @db.Uuid
  parentId       String?       @db.Uuid
  leadId         String?       @db.Uuid
  name           String
  keyPrefix      String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  nextTaskNumber Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team                  Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent                Project?               @relation("ProjectTree", fields: [parentId], references: [id], onDelete: SetNull)
  subprojects           Project[]              @relation("ProjectTree")
  lead                  User?                  @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  members               ProjectMember[]
  tasks                 Task[]
  meetings              Meeting[]
  knowledgeSpaces       KnowledgeSpace[]
  healthUpdates         ProjectHealthUpdate[]
  milestones            Milestone[]
  cycles                Cycle[]
  mattermostBindings    MattermostBinding[]
  departmentWorkTargets DepartmentWorkTarget[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, keyPrefix])
  @@index([workspaceId, parentId])
}

model ProjectHealthUpdate {
  id              String              @id @default(uuid()) @db.Uuid
  workspaceId     String              @db.Uuid
  projectId       String              @db.Uuid
  authorId        String?             @db.Uuid
  health          ProjectUpdateHealth
  summary         String
  progress        String?
  risks           String?
  decisionsNeeded String?
  nextUpdateDueAt DateTime?
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User?     @relation("ProjectHealthUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, projectId, createdAt])
  @@index([workspaceId, health, nextUpdateDueAt])
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Milestone {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  projectId   String           @db.Uuid
  ownerId     String?          @db.Uuid
  name        String
  description String?
  kind        MilestoneKind
  status      MilestoneStatus  @default(PLANNED)
  health      MilestoneHealth?
  startsOn    DateTime?        @db.Date
  targetOn    DateTime?        @db.Date
  position    Int              @default(1024)
  version     Int              @default(1)
  completedAt DateTime?
  canceledAt  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User?     @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([projectId, position])
  @@index([workspaceId, archivedAt, status, targetOn])
  @@index([ownerId, status])
}

model Cycle {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String?  @db.Uuid
  name        String
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  projectId   String       @db.Uuid
  cycleId     String?      @db.Uuid
  milestoneId String?      @db.Uuid
  parentId    String?      @db.Uuid
  key         String
  sequence    Int
  title       String
  description String?
  kind        TaskKind     @default(WORK)
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NO_PRIORITY)
  weight      Float?
  assigneeId  String?      @db.Uuid
  reporterId  String?      @db.Uuid
  dueAt       DateTime?
  completedAt DateTime?
  source      TaskSource   @default(WEB)
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycle                Cycle?                @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  milestone            Milestone?            @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent               Task?                 @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks             Task[]                @relation("TaskTree")
  assignee             User?                 @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter             User?                 @relation("ReportedTasks", fields: [reporterId], references: [id], onDelete: SetNull)
  comments             TaskComment[]
  attachments          TaskAttachment[]
  labels               TaskLabel[]
  subscriptions        TaskSubscription[]
  mutes                TaskMute[]
  reviewRequests       TaskReviewRequest[]
  triageState          TaskTriageState?
  meetingLinks         MeetingTask[]
  meetingActionItems   MeetingActionItem[]
  blockingDependencies TaskDependency[]      @relation("TaskBlockedBy")
  blockedTasks         TaskDependency[]      @relation("TaskBlocks")
  notifications        Notification[]
  supportCaseLinks     SupportCaseTaskLink[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, key])
  @@unique([projectId, sequence])
  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, dueAt])
  @@index([milestoneId, status])
  @@index([workspaceId, kind, status])
}

