  connectionId                 String                  @db.Uuid
  workTargetId                 String                  @db.Uuid
  supportWorkspaceId           String                  @db.Uuid
  teamWorkspaceId              String                  @db.Uuid
  caseId                       String                  @db.Uuid
  taskId                       String?                 @db.Uuid
  taskWorkspaceId              String?                 @db.Uuid
  relationType                 SupportCaseTaskLinkType
  handoffTitle                 String
  handoffSummary               String
  teamWorkspaceNameSnapshot    String
  taskKeySnapshot              String
  taskTitleSnapshot            String
  taskStatusSnapshot           TaskStatus
  supportWorkspaceNameSnapshot String
  caseKeySnapshot              String
  caseTitleSnapshot            String
  caseStatusSnapshot           SupportCaseSignalStatus
  lastTaskSignalAt             DateTime?
  lastCaseSignalAt             DateTime?
  connectionRevokedAt          DateTime?
  taskDeletedAt                DateTime?
  unlinkedAt                   DateTime?
  createdById                  String?                 @db.Uuid
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  workTarget DepartmentWorkTarget @relation(fields: [workTargetId, connectionId, supportWorkspaceId, teamWorkspaceId], references: [id, connectionId, supportWorkspaceId, teamWorkspaceId], onDelete: Restrict)
  case       SupportCase          @relation(fields: [supportWorkspaceId, caseId], references: [workspaceId, id], onDelete: Cascade)
  task       Task?                @relation(fields: [taskWorkspaceId, taskId], references: [workspaceId, id], onDelete: SetNull)
  createdBy  User?                @relation("SupportCaseTaskLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([caseId, teamWorkspaceId, taskKeySnapshot, relationType])
  @@unique([supportWorkspaceId, idempotencyKey])
  @@index([supportWorkspaceId, caseId, unlinkedAt])
  @@index([teamWorkspaceId, taskId, unlinkedAt])
  @@index([connectionId, connectionRevokedAt])
}
