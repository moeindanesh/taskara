  routingCapacity     Int                        @default(0)
  routingSkills       String[]                   @default([])
  deactivatedAt       DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  department      Department      @relation(fields: [workspaceId, departmentId], references: [workspaceId, id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  assignedCases   SupportCase[]   @relation("SupportCaseAssignee")

  @@unique([workspaceId, departmentId, id])
  @@unique([workspaceId, departmentId, userId])
  @@index([workspaceId, userId, active])
  @@index([departmentId, role, active])
}

