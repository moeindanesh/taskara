  assignee  User?     @relation("MeetingActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("MeetingActionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, meetingId, status])
  @@index([workspaceId, assigneeId, status, dueAt])
  @@index([taskId])
}

model KnowledgeSpace {
