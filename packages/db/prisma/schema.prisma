model Notification {
  id              String        @id @default(uuid()) @db.Uuid
  workspaceId     String        @db.Uuid
  userId          String        @db.Uuid
  /// Who caused this notification, and what they were. Required on write so a new notification
  /// site cannot silently ship without provenance; SYSTEM with a null actorId is the honest
  /// answer for scheduled jobs, and is what rows written before this column carry.
  actorId         String?       @db.Uuid
  actorType       ActorType
  actorRuntime    AgentRuntime?
  taskId          String?       @db.Uuid
  supportCaseId   String?       @db.Uuid
  announcementId  String?       @db.Uuid
  meetingId       String?       @db.Uuid
  knowledgePageId String?       @db.Uuid
  type            String
  title           String
  body            String?
  deliveredAt     DateTime?
  readAt          DateTime?
  createdAt       DateTime      @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User           @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor         User?          @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  supportCase   SupportCase?   @relation(fields: [workspaceId, supportCaseId], references: [workspaceId, id], onDelete: Restrict)
  announcement  Announcement?  @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  meeting       Meeting?       @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  knowledgePage KnowledgePage? @relation(fields: [knowledgePageId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, deliveredAt])
  @@index([userId, createdAt, id])
  @@index([actorId])
  @@index([supportCaseId])
  @@index([announcementId])
  @@index([meetingId])
  @@index([knowledgePageId])
}

