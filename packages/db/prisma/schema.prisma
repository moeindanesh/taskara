/// A Case assignee points to this membership, not directly to User. That makes “assigned to an
/// active member of the owning Department” a checkable invariant instead of a naming convention.
model DepartmentMember {
  id                  String                     @id @default(uuid()) @db.Uuid
  workspaceId         String                     @db.Uuid
  departmentId        String                     @db.Uuid
  userId              String                     @db.Uuid
