POSTGRES_USER="taskara"
POSTGRES_PASSWORD="replace-me"
POSTGRES_DB="taskara"
POSTGRES_PORT="5432"
REDIS_PORT="6379"

DATABASE_URL="postgresql://taskara:replace-me@localhost:5432/taskara?schema=public"
REDIS_URL="redis://localhost:6379"

API_HOST="0.0.0.0"
API_PORT="4000"
WEB_ORIGIN="http://localhost:3005"
TASKARA_ALLOWED_ORIGINS=""

VITE_DEV_HOST="0.0.0.0"
VITE_DEV_PORT="3005"
VITE_TASKARA_API_URL="http://localhost:4000"
VITE_TASKARA_CDN_UPLOAD_URL=""
VITE_TASKARA_CDN_MEDIA_BASE_URL=""
VITE_TASKARA_CDN_APP="taskara"

TASKARA_CDN_UPLOAD_URL=""
TASKARA_CDN_MEDIA_BASE_URL=""
TASKARA_CDN_APP="taskara"
TASKARA_RUN_MIGRATIONS="true"

# S3-compatible object storage. Set the first five together to serve media from a bucket instead of
# the CDN; leave them empty and nothing changes. The CDN variables above stay set either way — they
# are what keeps every attachment uploaded before the bucket existed resolving.
TASKARA_S3_ENDPOINT=""
TASKARA_S3_REGION=""
TASKARA_S3_BUCKET=""
TASKARA_S3_ACCESS_KEY_ID=""
TASKARA_S3_SECRET_ACCESS_KEY=""
# Where objects are publicly readable, when that is not <endpoint>/<bucket>: a CDN in front of the
# bucket, or a custom domain. Reads use this and need no credentials.
TASKARA_S3_PUBLIC_BASE_URL=""
TASKARA_S3_KEY_PREFIX=""
TASKARA_S3_UPLOAD_TTL_SECONDS=""
# Path-style (<endpoint>/<bucket>/<key>) unless this is on. When it is on, TASKARA_S3_ENDPOINT must
# already name the bucket-qualified host — the bucket is not inserted for you.
TASKARA_S3_VIRTUAL_HOSTED_STYLE=""

MATTERMOST_BASE_URL=""
MATTERMOST_BOT_TOKEN=""
MATTERMOST_SLASH_TOKEN=""
MATTERMOST_SYNTHETIC_EMAIL_DOMAIN="mattermost.example.invalid"
MATTERMOST_WORKSPACE_SLUG=""

SMS_KAVEH_KEY=""
SMS_KAVEH_SENDER=""
TASKARA_AI_CREDENTIAL_SECRET=""

TASKARA_API_URL="http://localhost:4000"
TASKARA_USER_EMAIL=""
TASKARA_WORKSPACE_SLUG=""
TASKARA_WEB_URL="http://localhost:3005"
TASKARA_MENUBAR_REFRESH_MS="60000"
